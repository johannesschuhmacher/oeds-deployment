FROM python:3.13-slim AS core

COPY --from=ghcr.io/astral-sh/uv:0.11.7 /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    PYTHONPATH=/app \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        git \
        libeccodes-dev && \
    rm -rf /var/lib/apt/lists/*

COPY CRAWLER_CONFIG.yml ./CRAWLER_CONFIG.yml
COPY crawler/data ./crawler/data

RUN mkdir -p ./modular_repos/docs
COPY modular_repos/modules/oeds-deployment/assembly/crawler-inventory.json ./modular_repos/docs/crawler-inventory.json
COPY modular_repos/sources/oeds-core ./modular_repos/sources/oeds-core
RUN uv venv /app/.venv --python /usr/local/bin/python && \
    uv pip install --python /app/.venv/bin/python \
        -r /app/modular_repos/sources/oeds-core/requirements.txt \
        -e /app/modular_repos/sources/oeds-core

FROM core AS crawlers
COPY modular_repos/modules/oeds-crawler-pack ./modular_repos/modules/oeds-crawler-pack
RUN uv pip install --python /app/.venv/bin/python \
        -e /app/modular_repos/modules/oeds-crawler-pack

FROM crawlers AS post
COPY modular_repos/modules/oeds-post-scripts ./modular_repos/modules/oeds-post-scripts
RUN uv pip install --python /app/.venv/bin/python \
        -e '/app/modular_repos/modules/oeds-post-scripts[price-forecast]'

FROM post AS runtime
COPY modular_repos/modules/oeds-scheduler-ui ./modular_repos/modules/oeds-scheduler-ui
RUN uv pip install --python /app/.venv/bin/python \
        -e /app/modular_repos/modules/oeds-scheduler-ui

RUN useradd --create-home --shell /bin/bash oeds && \
    mkdir -p /app/logs /var/lib/oeds-admin && \
    chown -R oeds:oeds /app/logs /app/crawler /var/lib/oeds-admin

USER oeds

CMD ["oeds-scheduler", "--config", "/app/CRAWLER_CONFIG.yml", "--inventory", "/app/modular_repos/docs/crawler-inventory.json", "--workspace-root", "/app/modular_repos", "--daemon"]
